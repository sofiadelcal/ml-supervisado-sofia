## Experimento

La validación cruzada usa únicamente las 133 observaciones de entrenamiento. Las 45 restantes se abren una sola vez para la comparación final.

"""Comparación de seis clasificadores sobre el conjunto Wine.

El objetivo es reconocer tres cultivares a partir de 13 mediciones químicas.
Todos los modelos usan la misma partición y la validación cruzada se realiza
solo con los datos de entrenamiento.
"""

from __future__ import annotations

import json
from pathlib import Path

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn.calibration import CalibratedClassifierCV
from sklearn.datasets import load_wine
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    ConfusionMatrixDisplay,
    accuracy_score,
    auc,
    classification_report,
    confusion_matrix,
    precision_recall_fscore_support,
    roc_auc_score,
    roc_curve,
)
from sklearn.model_selection import StratifiedKFold, cross_validate, train_test_split
from sklearn.naive_bayes import GaussianNB
from sklearn.neighbors import KNeighborsClassifier
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler, label_binarize
from sklearn.svm import SVC
from sklearn.tree import DecisionTreeClassifier


ROOT = Path.cwd()  # En Colab, los resultados quedan en la carpeta de la sesión
SEED = 23
TEST_SIZE = 0.25
CLASS_NAMES = ["Cultivar 1", "Cultivar 2", "Cultivar 3"]


def build_models() -> dict[str, object]:
    """Devuelve configuraciones contenidas y comparables."""
    scaled = lambda model: Pipeline(
        [("escala", StandardScaler()), ("modelo", model)]
    )
    return {
        "Regresión logística": scaled(
            LogisticRegression(C=1.0, max_iter=3_000, random_state=SEED)
        ),
        "Árbol de decisión": DecisionTreeClassifier(
            max_depth=4, min_samples_leaf=2, random_state=SEED
        ),
        "Bosque aleatorio": RandomForestClassifier(
            n_estimators=350,
            max_features="sqrt",
            min_samples_leaf=1,
            random_state=SEED,
            n_jobs=-1,
        ),
        "SVM": scaled(
            CalibratedClassifierCV(
                SVC(C=2.0, kernel="rbf", random_state=SEED),
                method="sigmoid",
                cv=3,
            )
        ),
        "KNN": scaled(KNeighborsClassifier(n_neighbors=7, weights="distance")),
        "Naive Bayes": scaled(GaussianNB()),
    }


def probability_matrix(model: object, features: pd.DataFrame) -> np.ndarray:
    """Obtiene probabilidades de clase con una interfaz común."""
    if not hasattr(model, "predict_proba"):
        raise TypeError("El modelo no expone predict_proba")
    return np.asarray(model.predict_proba(features))


def plot_metrics(table: pd.DataFrame) -> None:
    columns = ["exactitud", "precision_macro", "recall_macro", "f1_macro", "auc_macro"]
    labels = ["Exactitud", "Precisión", "Recall", "F1", "AUC"]
    colors = ["#31572C", "#4F772D", "#90A955", "#ECBA82", "#D77A61"]
    figure, axis = plt.subplots(figsize=(10.8, 6.2), layout="constrained")
    base_y = np.arange(len(table))
    offsets = np.linspace(-0.22, 0.22, len(columns))
    for column, label, color, offset in zip(columns, labels, colors, offsets):
        axis.scatter(
            table[column], base_y + offset, s=52, color=color, label=label,
            edgecolor="white", linewidth=0.5, zorder=3,
        )
    axis.set_yticks(base_y, table["modelo"])
    axis.invert_yaxis()
    axis.set_xlim(0.86, 1.005)
    axis.set_xlabel("Puntaje en el conjunto reservado")
    axis.set_title("Perfil de desempeño: cinco métricas por modelo", weight="bold")
    axis.grid(axis="x", alpha=0.22)
    axis.legend(ncol=5, loc="lower center", bbox_to_anchor=(0.5, -0.18))
    figure.savefig(ROOT / "perfil_metricas_sofia.png", dpi=220, bbox_inches="tight")
    plt.close(figure)


def plot_confusions(matrices: dict[str, list[list[int]]]) -> None:
    figure, axes = plt.subplots(3, 2, figsize=(9.2, 11.2), layout="constrained")
    for axis, (name, matrix) in zip(axes.ravel(), matrices.items()):
        display = ConfusionMatrixDisplay(np.asarray(matrix), display_labels=["C1", "C2", "C3"])
        display.plot(ax=axis, colorbar=False, cmap="PuBuGn", values_format="d")
        axis.set_title(name, fontsize=10, weight="bold")
        axis.set_xlabel("Predicción")
        axis.set_ylabel("Real")
    figure.suptitle("Matrices de confusión por modelo", weight="bold")
    figure.savefig(ROOT / "mapa_errores_sofia.png", dpi=220, bbox_inches="tight")
    plt.close(figure)


def plot_roc_curves(
    y_test: pd.Series, probabilities: dict[str, np.ndarray]
) -> None:
    binary = label_binarize(y_test, classes=[0, 1, 2])
    colors = ["#31572C", "#4F772D", "#90A955", "#D77A61", "#7B2CBF", "#277DA1"]
    figure, axes = plt.subplots(2, 3, figsize=(11.2, 7.2), sharex=True, sharey=True, layout="constrained")
    for axis, ((name, scores), color) in zip(axes.ravel(), zip(probabilities.items(), colors)):
        fpr, tpr, _ = roc_curve(binary.ravel(), scores.ravel())
        value = auc(fpr, tpr)
        axis.plot(fpr, tpr, color=color, linewidth=2)
        axis.fill_between(fpr, tpr, alpha=0.12, color=color)
        axis.plot([0, 1], [0, 1], linestyle="--", color="#777777", linewidth=0.8)
        axis.set_title(f"{name}\nAUC micro = {value:.3f}", fontsize=10, weight="bold")
        axis.grid(alpha=0.18)
    for axis in axes[-1, :]:
        axis.set_xlabel("Falsos positivos")
    for axis in axes[:, 0]:
        axis.set_ylabel("Verdaderos positivos")
    figure.suptitle("Separación probabilística, modelo por modelo", weight="bold")
    figure.savefig(ROOT / "roc_por_modelo_sofia.png", dpi=220, bbox_inches="tight")
    plt.close(figure)


def main() -> None:
    dataset = load_wine(as_frame=True)
    features = dataset.data
    target = dataset.target
    x_train, x_test, y_train, y_test = train_test_split(
        features,
        target,
        test_size=TEST_SIZE,
        random_state=SEED,
        stratify=target,
    )

    folds = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
    scoring = {
        "exactitud": "accuracy",
        "precision_macro": "precision_macro",
        "recall_macro": "recall_macro",
        "f1_macro": "f1_macro",
        "auc_macro": "roc_auc_ovr",
    }

    test_rows: list[dict[str, float | str]] = []
    cv_rows: list[dict[str, float | str]] = []
    matrices: dict[str, list[list[int]]] = {}
    reports: dict[str, object] = {}
    probabilities: dict[str, np.ndarray] = {}

    for name, model in build_models().items():
        validation = cross_validate(
            model, x_train, y_train, cv=folds, scoring=scoring, n_jobs=-1
        )
        cv_row: dict[str, float | str] = {"modelo": name}
        for metric in scoring:
            values = validation[f"test_{metric}"]
            cv_row[f"{metric}_media"] = round(float(np.mean(values)), 6)
            cv_row[f"{metric}_desv"] = round(float(np.std(values)), 6)
        cv_rows.append(cv_row)

        model.fit(x_train, y_train)
        prediction = model.predict(x_test)
        scores = probability_matrix(model, x_test)
        probabilities[name] = scores
        precision, recall, f1, _ = precision_recall_fscore_support(
            y_test, prediction, average="macro", zero_division=0
        )
        test_rows.append(
            {
                "modelo": name,
                "exactitud": round(float(accuracy_score(y_test, prediction)), 6),
                "precision_macro": round(float(precision), 6),
                "recall_macro": round(float(recall), 6),
                "f1_macro": round(float(f1), 6),
                "auc_macro": round(
                    float(roc_auc_score(y_test, scores, multi_class="ovr", average="macro")),
                    6,
                ),
            }
        )
        matrices[name] = confusion_matrix(y_test, prediction).tolist()
        reports[name] = classification_report(
            y_test,
            prediction,
            target_names=CLASS_NAMES,
            output_dict=True,
            zero_division=0,
        )

    test_table = pd.DataFrame(test_rows).sort_values(
        ["f1_macro", "exactitud"], ascending=False
    )
    cv_table = pd.DataFrame(cv_rows)
    test_table.to_csv(ROOT / "metricas_prueba_sofia.csv", index=False)
    cv_table.to_csv(ROOT / "metricas_validacion_sofia.csv", index=False)
    (ROOT / "matrices_confusion_sofia.json").write_text(
        json.dumps(matrices, ensure_ascii=False, indent=2), encoding="utf-8"
    )
    (ROOT / "reportes_clasificacion_sofia.json").write_text(
        json.dumps(reports, ensure_ascii=False, indent=2), encoding="utf-8"
    )
    summary = {
        "estudiante": "Sofía",
        "conjunto": "Wine Recognition",
        "observaciones": int(len(features)),
        "variables": int(features.shape[1]),
        "clases": int(target.nunique()),
        "entrenamiento": int(len(x_train)),
        "prueba": int(len(x_test)),
        "semilla": SEED,
        "mejor_modelo_f1": str(test_table.iloc[0]["modelo"]),
        "mejor_f1_macro": float(test_table.iloc[0]["f1_macro"]),
    }
    (ROOT / "resumen_experimento_sofia.json").write_text(
        json.dumps(summary, ensure_ascii=False, indent=2), encoding="utf-8"
    )

    plot_metrics(test_table)
    plot_confusions(matrices)
    plot_roc_curves(y_test, probabilities)
    print(test_table.to_string(index=False))
    print(json.dumps(summary, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()

## Lectura breve

Si varios modelos empatan en la prueba, conviene mirar la media y la dispersión de validación. El conjunto Wine es pequeño y está bien separado; por eso un resultado perfecto en 45 casos no demuestra que el modelo generalice a otras regiones, cosechas o instrumentos de laboratorio.
